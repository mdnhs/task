# Web app server environment (copy to .env.local). Server-only: none of these is ever NEXT_PUBLIC_*, and scripts/check-bundle.mjs
# fails the build gate if API_URL (or a secret) reaches .next/static.

# Where server code reaches the API (internal address, no trailing slash). The BFF (/v1, /api/auth) and server components call it.
API_URL=http://localhost:3001

# The public web origin (scheme://host[:port], no path): what the browser's Origin must equal on a state-changing call.
# Must be the same value as the API's APP_URL (Better Auth trustedOrigins, cookie host, Google callback). Required in production: the server refuses to boot without it
# (and without API_URL), see instrumentation.ts / lib/env.ts.
APP_ORIGIN=http://localhost:3000

# Demo deployments only (B6 ruling I16): show the mock-only modules (rosters, orders and stock, ...). Unset on a real client's deployment.
# ENABLE_MOCK_MODULES=1
