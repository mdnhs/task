{
  "domain": "opsdesk.app",
  "defaultPlan": "business",
  "locale": "en-IE",
  "countries": [
    { "code": "IE", "name": "Ireland", "timezone": "Europe/Dublin" },
    { "code": "GB", "name": "United Kingdom", "timezone": "Europe/London" },
    { "code": "DE", "name": "Germany", "timezone": "Europe/Berlin" },
    { "code": "US", "name": "United States", "timezone": "America/New_York" },
    { "code": "AE", "name": "United Arab Emirates", "timezone": "Asia/Dubai" }
  ],
  "timezones": [
    { "value": "Europe/Dublin", "label": "Irish time (Europe/Dublin)" },
    { "value": "Europe/London", "label": "UK time (Europe/London)" },
    { "value": "Europe/Berlin", "label": "Central European time (Europe/Berlin)" },
    { "value": "America/New_York", "label": "US Eastern time (America/New_York)" },
    { "value": "Asia/Dubai", "label": "Gulf time (Asia/Dubai)" }
  ],
  "deadline": "17:30",
  "reportDueAfterMinutes": 60,
  "reportTemplate": {
    "sections": [
      { "id": "tasks", "title": "Tasks in the shift", "enabled": true, "fields": [{ "id": "time", "label": "Time spent on done and in-progress tasks", "required": true }, { "id": "note", "label": "Note on blocked tasks", "required": true }] },
      { "id": "summary", "title": "Summary", "enabled": true, "fields": [{ "id": "summary", "label": "Shift summary", "required": true }] },
      { "id": "blockers", "title": "Blockers", "enabled": true, "fields": [{ "id": "blockers", "label": "Blockers", "required": false }] },
      { "id": "unplanned", "title": "Unplanned work", "enabled": true, "fields": [{ "id": "unplanned", "label": "Unplanned work rows", "required": false }] },
      { "id": "attachments", "title": "Attachments", "enabled": true, "fields": [{ "id": "attachments", "label": "Photos and files", "required": false }] }
    ]
  },
  "departments": ["Security", "Cleaning"],
  "reportSections": [
    "Staff / Attendance",
    "Client Issues",
    "Rosters",
    "Recruitment",
    "Employee Files",
    "Client Files",
    "Payroll",
    "Orders / Stock",
    "Outstanding",
    "Manager Attention Required"
  ],
  "inviteRoles": ["admin", "manager", "supervisor", "employee"]
}
