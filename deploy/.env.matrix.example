# Names only. Copy to your Dokploy Environment tab and fill the real values there (the secret store); never commit a filled copy.
# Full explanation per variable: .claude/docs/deploy/env-matrix.md. Anything marked CHANGE_ME must be replaced; empty means "optional, unset".

# --- compose images (Dokploy build or registry) ---
API_IMAGE=
WEB_IMAGE=
SEED_IMAGE=

# --- required in production ---
APP_URL=CHANGE_ME
DATABASE_URL=CHANGE_ME
DATABASE_OWNER_URL=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
BETTER_AUTH_SECRET=CHANGE_ME
SECRETS_KEY=CHANGE_ME
DATA_REGION=CHANGE_ME
TRUST_PROXY_HOPS=CHANGE_ME

# --- optional keyring for SECRETS_KEY rotation ---
SECRETS_KEYS=
SECRETS_KEY_ID=

# --- optional tuning (defaults in env-matrix.md) ---
ENABLE_MOCK_MODULES=
FILE_MAX_BYTES=
TASK_EVIDENCE_MAX_BYTES=
TASK_VIDEO_MAX_BYTES=
TASK_VOICE_MAX_BYTES=
AUTH_RATE_LIMIT_PER_MIN=
TENANT_CREATE_MAX_PER_USER=
LOG_LEVEL=

# --- optional sign-in providers (env only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_INTEGRATION_CLIENT_ID=
GOOGLE_INTEGRATION_CLIENT_SECRET=
GOOGLE_INTEGRATION_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- demo deployment only (profile demo), never on a client's database ---
ALLOW_DEMO_SEED=
SEED_DEMO_PASSWORD=
SEED_EMAIL_DOMAIN=
SEED_PLATFORM_TOTP_SECRET=

# --- laptop dry run only (profile local) ---
LOCAL_POSTGRES_PASSWORD=CHANGE_ME
LOCAL_MINIO_USER=CHANGE_ME
LOCAL_MINIO_PASSWORD=CHANGE_ME
