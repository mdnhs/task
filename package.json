{
  "name": "task",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "test:api": "npm -w api test",
    "api:types": "node scripts/api-types.mjs",
    "api:types:check": "node scripts/api-types.mjs --check",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:audit": "node scripts/audit-gate.mjs",
    "load:prepare": "npm -w api exec -- tsx scripts/load-prepare.ts",
    "load:smoke": "k6 run load/k6/smoke.js",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:all:down": "node scripts/dev-all.mjs down",
    "dev:all:reset": "node scripts/dev-all.mjs reset",
    "dev:all:totp": "node scripts/dev-all.mjs totp",
    "e2e:stack": "docker compose -f docker-compose.e2e.yml up -d --wait",
    "e2e:stack:down": "docker compose -f docker-compose.e2e.yml down -v",
    "test:e2e": "playwright test --project=desktop --project=android",
    "test:e2e:skeletons": "playwright test --project=skeletons --workers=1"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.3",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "motion": "^12.43.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "workspaces": [
    "api",
    "packages/*"
  ]
}
